{
  "name": "realx8-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Realx8 web app. Talks to Realx8-Core over one base URL.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "cf:dev": "npm run build && wrangler dev --env=\"\"",
    "cf:deploy": "npm run build && wrangler deploy --env=\"\"",
    "cf:deploy:prod": "npm run build && wrangler deploy --env production",
    "verify:export": "node scripts/verify-export.cjs",
    "verify:dashboard-export": "node scripts/verify-dashboard-export.cjs",
    "verify:interop": "node scripts/verify-payload-interop.cjs",
    "lint:nav": "node scripts/lint-nav.js",
    "lint": "eslint src",
    "assistant:build-kb": "node scripts/build-assistant-kb.mjs",
    "assistant:test": "node src/assistant/kb/kb-integrity.test.mjs && node src/assistant/assistant.test.mjs && node src/assistant/converse.test.mjs",
    "verify:launcher": "node scripts/verify-launcher-layout.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "axios": "^1.10.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "wrangler": "^4.86.0"
  }
}
