# Serves the built app and forwards the API to Realx8-Core.
#
# ${API_TARGET} is substituted from the environment when the container starts
# (nginx:alpine runs envsubst over /etc/nginx/templates). Only the variables
# named in the container's env are replaced, so nginx's own $host / $uri are
# safe here.

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # ── Security headers ──────────────────────────────────────────────────────
  #
  # Identical to vercel.json and worker/index.js; whichever fronts a deployment,
  # the app is served with the same policy. `always` so they are set on error
  # responses too, which is where a header is most often quietly missing.
  #
  # The CSP was verified against a production build in a real browser — sign-in
  # plus eight authenticated screens, zero violations. Each allowance is
  # something the app actually loads: Cloudinary documents, OpenStreetMap tiles,
  # the font picker's two font hosts, and the embedded video players.
  # ${API_TARGET} is in connect-src/img-src/media-src because a build can point
  # VITE_API_BASE_URL straight at the backend instead of using the proxy below;
  # then the page is talking cross-origin and 'self' would block every request.
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.fontshare.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.tile.openstreetmap.org https://images.unsplash.com https://img.youtube.com https://i.ytimg.com ${API_TARGET}; media-src 'self' blob: https://res.cloudinary.com ${API_TARGET}; connect-src 'self' https://res.cloudinary.com ${API_TARGET}; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://drive.google.com; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header Permissions-Policy "camera=(), microphone=(), payment=(), geolocation=(self)" always;

  # Realx8-Core answers every route under /api, so the prefix is passed through
  # unchanged rather than stripped.
  location /api/ {
    proxy_pass ${API_TARGET}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The assistant streams its reply token by token; buffering would hold the
    # whole answer back until it finished.
    proxy_buffering off;
    proxy_read_timeout 180s;
  }

  # Property images and documents, served by user-service.
  location /uploads/ {
    proxy_pass ${API_TARGET}/uploads/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed assets are immutable; index.html must never be cached or a deploy
  # leaves browsers holding stale asset references.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Client-side routing: every unknown path is a React route, not a 404.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store";
  }
}
