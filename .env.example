# Realx8-Ui environment
#
# API base. In development the Vite proxy forwards /api to the backend, so this
# is usually left unset.
# VITE_API_BASE=http://localhost:3000/api

# ── Frontend request signature ────────────────────────────────────────────────
# Must match SECURITY_FRONTEND_APP_ID / SECURITY_FRONTEND_SECRET in the
# backend's cred.env, or every request is refused with 403.
#
# NOTE: this value ships inside the built JavaScript and is readable by anyone
# who opens the bundle. It is a barrier against casual scripting, NOT a secret
# and NOT authentication — see src/api/frontendSignature.js. Do not reuse a key
# that protects anything else.
VITE_FRONTEND_APP_ID=realx8-ui
VITE_FRONTEND_SECRET=change-me-to-match-the-backend
VITE_FRONTEND_HEADER_NAME=X-Realx8-Auth

# ── API payload encryption ───────────────────────────────────────────────────
# Must match the backend's PAYLOAD_ENCRYPTION_MODE: leave this off while the
# backend is off. Get the bootstrap key by running, in Realx8-Core:
#   npm run payload:bootstrap-key
# It is derived from the backend secret, so the two cannot drift apart.
#
# The bootstrap key is NOT a secret — it ships in this bundle and anyone can
# read it. It covers only pre-login calls; authenticated traffic uses a
# per-session key the server mints at sign-in.
VITE_PAYLOAD_ENCRYPTION=off
VITE_PAYLOAD_BOOTSTRAP_KEY=

# ── Devtools deterrence ──────────────────────────────────────────────────────
# Blocks right-click and the devtools shortcuts in PRODUCTION builds only.
# Deterrence against casual inspection, not a security control — devtools
# cannot be disabled from a web page and everything sent to the browser stays
# readable. Set to off to disable.
VITE_DEVTOOLS_DETERRENCE=on
