# ============================================================
#  Realx8-Ui — environment
#  Copy to .env and adjust.  cp .env.example .env
# ============================================================

# Where the app sends API calls.
#
# Leave as /api (relative) whenever something in front of this app forwards
# /api to Realx8-Core — the Vite dev server does it via DEV_API_TARGET below,
# nginx does it in the Docker image, Vercel does it via vercel.json. The browser
# stays same-origin, so there is no CORS involved at all.
#
# Set it to an absolute URL to call the backend cross-origin instead:
#   VITE_API_BASE_URL=https://realx8-core.up.railway.app/api
# If you do, that origin must be listed in Realx8-Core's CORS_ORIGIN.
VITE_API_BASE_URL=/api

# Dev only: where `npm run dev` forwards /api and /uploads.
# This is Realx8-Core's port — the same 3000 whether it runs as one service or
# as the api-gateway of a fully split backend.
DEV_API_TARGET=http://localhost:3000
